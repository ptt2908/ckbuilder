# Optional public CKB configuration for CKB Studio — xUDT Token Manager.
# Copy this file to .env.local for local overrides.
# IMPORTANT: All VITE_* variables are embedded into the public browser bundle.
# Never place private keys, seed phrases, or secret API tokens in VITE_* variables.

VITE_CKB_NETWORK_NAME="CKB Testnet"
VITE_CKB_NETWORK_ID="ckb_testnet"
VITE_CKB_EXPLORER_URL="https://v1.testnet.explorer.nervos.org"
# Optional custom public CKB Testnet JSON-RPC endpoint (uses CCC public Testnet RPC when blank)
VITE_CKB_RPC_URL=""
